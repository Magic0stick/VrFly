# Режим разработки
VITE_APP_ENV=development

# Режим VR (auto/steamvr/oculus/desktop)
VITE_VR_MODE=auto

# Включить SteamVR поддержку
VITE_ENABLE_STEAMVR=true

# Включить Oculus/Meta поддержку
VITE_ENABLE_OCULUS=true

# Включить hand tracking
VITE_ENABLE_HAND_TRACKING=true

# Включить haptic feedback
VITE_ENABLE_HAPTICS=true

# Разрешение рендеринга (0.5 - 2.0)
VITE_RENDER_SCALE=1.0

# Дальность прорисовки
VITE_RENDER_DISTANCE=5000

# Максимальное количество жуков
VITE_MAX_BUGS=30

# Максимальное количество дронов
VITE_MAX_DRONES=8

# Скорость самолёта (множитель)
VITE_AIRPLANE_SPEED=1.0

# Включить эффекты частиц
VITE_ENABLE_PARTICLES=true

# Включить тени
VITE_ENABLE_SHADOWS=true

# Качество теней (low/medium/high)
VITE_SHADOW_QUALITY=medium

# Включить туман
VITE_ENABLE_FOG=true

# Плотность тумана
VITE_FOG_DENSITY=0.00015

# Включить радар
VITE_ENABLE_RADAR=true

# Включить звуки
VITE_ENABLE_SOUNDS=true

# Громкость (0.0 - 1.0)
VITE_VOLUME=0.7

# Включить музыку
VITE_ENABLE_MUSIC=true

# Включить тактильную отдачу
VITE_ENABLE_VIBRATION=true

# Отладочный режим
VITE_DEBUG=false

# Показывать FPS
VITE_SHOW_FPS=false

# Показывать границы Chaperone
VITE_SHOW_CHAPERONE=true
