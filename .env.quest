# Quest 2 Optimized Settings
VITE_APP_ENV=production
VITE_VR_MODE=oculus
VITE_ENABLE_STEAMVR=false
VITE_ENABLE_OCULUS=true
VITE_ENABLE_HAND_TRACKING=true
VITE_ENABLE_HAPTICS=true
VITE_RENDER_SCALE=0.8
VITE_RENDER_DISTANCE=3000
VITE_MAX_BUGS=20
VITE_MAX_DRONES=5
VITE_AIRPLANE_SPEED=0.9
VITE_ENABLE_PARTICLES=true
VITE_ENABLE_SHADOWS=true
VITE_SHADOW_QUALITY=low
VITE_ENABLE_FOG=true
VITE_FOG_DENSITY=0.0002
VITE_ENABLE_RADAR=true
VITE_ENABLE_SOUNDS=true
VITE_VOLUME=0.7
VITE_ENABLE_MUSIC=true
VITE_ENABLE_VIBRATION=true
VITE_DEBUG=false
VITE_SHOW_FPS=false
VITE_SHOW_CHAPERONE=false
